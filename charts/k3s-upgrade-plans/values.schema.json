{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["k3s", "upgrade", "server", "agent", "window"],
  "properties": {
    "k3s": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+$"
        }
      }
    },
    "upgrade": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "server": {
      "type": "object",
      "required": ["concurrency", "jobActiveDeadlineSecs", "postCompleteDelay"],
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "jobActiveDeadlineSecs": {
          "type": "integer",
          "minimum": 1
        },
        "postCompleteDelay": {
          "type": "string"
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["concurrency", "jobActiveDeadlineSecs", "postCompleteDelay"],
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "jobActiveDeadlineSecs": {
          "type": "integer",
          "minimum": 1
        },
        "postCompleteDelay": {
          "type": "string"
        }
      }
    },
    "window": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        }
      }
    }
  }
}
